{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://springfield-ham-radio.github.io/radio-module-catalog/catalog.schema.json",
  "title": "Springfield Radio Module Catalog",
  "description": "Official index of installable radio-module packages for the Ham Radio desktop app.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modules"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Catalog format version. The app rejects unsupported versions."
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "package",
          "manufacturer",
          "version",
          "supportedRadios",
          "minApiVersion",
          "downloadUrl",
          "integrity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable module id used for on-disk install paths (e.g. baofeng)."
          },
          "package": {
            "type": "string",
            "minLength": 1,
            "description": "npm package name for developers (e.g. @springfield/radio-module-baofeng)."
          },
          "manufacturer": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "Module package version (semver)."
          },
          "supportedRadios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "minApiVersion": {
            "type": "string",
            "minLength": 1,
            "description": "Minimum @springfield/ham-radio-api version required by this module."
          },
          "downloadUrl": {
            "type": "string",
            "format": "uri",
            "description": "HTTPS URL of the JSON-only module zip on GitHub Releases."
          },
          "integrity": {
            "type": "string",
            "pattern": "^sha256:[a-fA-F0-9]{64}$",
            "description": "SHA-256 of the zip as sha256:<hex>."
          }
        }
      }
    }
  }
}
