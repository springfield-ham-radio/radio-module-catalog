{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://springfield-ham-radio.github.io/radio-module-catalog/catalog.schema.json",
  "title": "Springfield Radio Module Catalog",
  "description": "Official index of installable per-radio module packages for the Ham Radio desktop app (ADR 0009 schema version 3). Each entry is one radio zip on GitHub Releases.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modules"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 3,
      "description": "Catalog format version. The app rejects unsupported versions."
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "package",
          "manufacturer",
          "name",
          "version",
          "config",
          "minApiVersion",
          "downloadUrl",
          "integrity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$",
            "description": "Radio config id.model (e.g. kenwood-th-f6, baofeng-uv5r)."
          },
          "package": {
            "type": "string",
            "pattern": "^@springfield/radio-module-[a-z0-9]+(?:-[a-z0-9]+)+$",
            "description": "Logical package name for developers (e.g. @springfield/radio-module-kenwood-th-f6)."
          },
          "manufacturer": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Radio display name from config id.name."
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
            "description": "Driver config version (semver) from configs/*.json."
          },
          "config": {
            "type": "string",
            "pattern": "^configs/[^/]+\\.json$",
            "description": "Path of the config inside the zip."
          },
          "minApiVersion": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
            "description": "Minimum @springfield/ham-radio-api version required by this radio config."
          },
          "downloadUrl": {
            "type": "string",
            "format": "uri",
            "description": "HTTPS URL of the per-radio JSON zip on GitHub Releases."
          },
          "integrity": {
            "type": "string",
            "pattern": "^sha256:[a-fA-F0-9]{64}$",
            "description": "SHA-256 of the zip as sha256:<hex>."
          }
        }
      }
    }
  }
}
